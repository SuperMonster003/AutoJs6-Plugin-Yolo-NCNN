<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <service
            android:name=".YoloPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="yolo" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
        </service>

        <service
            android:name=".provider.YoloProviderService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":provider">
            <intent-filter>
                <action android:name="org.autojs.plugin.YOLO" />
                <category android:name="yolo" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
        </service>

    </application>

</manifest>
