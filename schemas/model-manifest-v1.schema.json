{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autojs6:yolo-ncnn:model-manifest:1",
  "title": "AutoJs6 YOLO NCNN model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engine",
    "backend",
    "family",
    "variant",
    "task",
    "input",
    "output",
    "labels"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "const": "yolo" },
    "backend": { "const": "ncnn" },
    "family": { "const": "ultralytics" },
    "variant": { "const": "yolo11" },
    "task": { "const": "detect" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "width",
        "height",
        "color",
        "layout",
        "letterbox",
        "scale",
        "paddingValue"
      ],
      "properties": {
        "name": { "const": "in0" },
        "width": { "const": 640 },
        "height": { "const": 640 },
        "color": { "const": "RGB" },
        "layout": { "const": "NCHW" },
        "letterbox": { "const": true },
        "scale": { "const": 0.00392156862745098 },
        "paddingValue": { "const": 114 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decoder", "shape", "coordinates", "objectness"],
      "properties": {
        "name": { "const": "out0" },
        "decoder": { "const": "ultralytics-detect" },
        "shape": {
          "type": "array",
          "prefixItems": [
            { "const": 1 },
            { "type": "integer", "minimum": 5, "maximum": 260 },
            { "const": 8400 }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "$comment": "The provider additionally requires shape[1] == 4 + labels.length."
        },
        "coordinates": { "const": "cxcywh" },
        "objectness": { "const": false }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "$comment": "The provider rejects blank labels and limits each label to 256 UTF-8 bytes."
      }
    }
  }
}
